# Copy this file to `.env` if you want a local checklist of variables.
# `.env` is gitignored. Do NOT put a real App Password or other secrets in git.
#
# Spring Boot does not load `.env` by itself. Export these in your shell, or copy
# the same values into gitignored `application-local.properties`.
# Profile: development (default) or production. No passwords in committed profile files.
SPRING_PROFILES_ACTIVE=development

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Input files
MAIL_EXCEL_FILE_PATH=
MAIL_BODY_FILE_PATH=
MAIL_ATTACHMENT_PATH=
MAIL_SENT_LOG_PATH=sent-addresses.txt

# Sending
MAIL_SUBJECT=
MAIL_BATCH_ENABLED=false
MAIL_DRY_RUN=true
MAIL_HTML=false
MAIL_SEND_DELAY_MS=1000
MAIL_TEST_SEND_ENABLED=false
MAIL_TEST_SEND_TO=

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_MAILSENDER=INFO
LOGGING_LEVEL_SMTP=INFO

# API profile (SPRING_PROFILES_ACTIVE=api). Leave empty locally until you run Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=excelmail
DB_USERNAME=excelmail
DB_PASSWORD=

# API auth (never commit real values)
APP_JWT_SECRET=
APP_ENCRYPTION_KEY=
