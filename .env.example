# Copy this file to `.env` if you want a local checklist of variables.
# `.env` is gitignored. Do NOT put a real App Password or other secrets in git.
#
# Spring Boot does not load `.env` by itself. Export these in your shell, or copy
# the same values into gitignored `application-local.properties`.
# Prefer MAIL_* names; SMTP_* is an alias used only when the matching MAIL_* is unset.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

MAIL_TEST_SEND_ENABLED=false
MAIL_TEST_SEND_TO=
