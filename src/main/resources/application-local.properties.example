# Copy this file to application-local.properties (gitignored) and fill in values.
# Gmail: use an App Password, not your account password.

spring.mail.username=your.address@gmail.com
spring.mail.password=your-app-password

mail.from=your.address@gmail.com
mail.excel-file-path=C:\\path\\to\\recipients.xlsx
mail.body-file-path=C:\\path\\to\\body.txt
mail.attachment-path=C:\\path\\to\\resume.pdf
# Leave batch off and dry-run on until you are ready to send.
mail.batch-enabled=false
mail.dry-run=true
mail.html=false
mail.sent-log-path=sent-addresses.txt
mail.send-delay-ms=1000
